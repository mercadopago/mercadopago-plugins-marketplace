#!/usr/bin/env bash
#
# Pre-commit hook for mercadopago-plugins-marketplace.
#
# Runs the repository validation gate locally before each commit. Enable it
# with: bash scripts/install-git-hooks.sh
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

exec sh scripts/validate_repository.sh
