{
  "description": "Mercado Pago developer plugin hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/validate_mp_credentials.py",
            "timeout": 10,
            "statusMessage": "Checking for hardcoded Mercado Pago credentials"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/check_version.py",
            "timeout": 10,
            "statusMessage": "Checking Mercado Pago plugin version"
          }
        ]
      }
    ]
  }
}
